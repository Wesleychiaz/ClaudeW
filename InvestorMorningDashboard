var US_TICKERS  = ["ASTS","AMZN","CRWD","GOOG","MSFT","PLTR","ZS","NOW","QQQ"];
var SG_TICKERS  = ["D05.SI","O39.SI","AU8U.SI","C38U.SI","YF8.SI","DCRU.SI"];
var CG_IDS      = { BTC:"bitcoin", ETH:"ethereum", DOT:"polkadot-2" };

var iColor = { positive:"#22c55e", negative:"#ef4444", neutral:"#94a3b8" };
var iIcon  = { positive:"(+)", negative:"(-)", neutral:"(o)" };
var aColor = { buy:"#22c55e", sell:"#ef4444", hold:"#6366f1", watch:"#f59e0b" };

var liveData = { fg: null, prices: {}, crypto: {} };

function ge(id) { return document.getElementById(id); }
function setStatus(msg) { ge("status-bar").textContent = msg; }

function fgColor(v) {
  if (v <= 25) { return "#ef4444"; }
  if (v <= 45) { return "#f97316"; }
  if (v <= 55) { return "#eab308"; }
  if (v <= 75) { return "#84cc16"; }
  return "#22c55e";
}

function fgLabel(v) {
  if (v <= 25) { return "Extreme Fear"; }
  if (v <= 45) { return "Fear"; }
  if (v <= 55) { return "Neutral"; }
  if (v <= 75) { return "Greed"; }
  return "Extreme Greed";
}

function switchTab(id, btn) {
  var panels = document.querySelectorAll(".tab-panel");
  for (var i = 0; i < panels.length; i++) { panels[i].classList.remove("active"); }
  var btns = document.querySelectorAll("nav button");
  for (var i = 0; i < btns.length; i++) { btns[i].classList.remove("active"); }
  ge("tab-" + id).classList.add("active");
  btn.classList.add("active");
}

/* ---- Fetch helpers ---- */

function fetchFearGreed(cb) {
  var url = "https://corsproxy.io/?" + encodeURIComponent("https://production.dataviz.cnn.io/index/fearandgreed/graphdata");
  var xhr = new XMLHttpRequest();
  xhr.open("GET", url, true);
  xhr.onreadystatechange = function() {
    if (xhr.readyState === 4) {
      if (xhr.status === 200) {
        try {
          var json = JSON.parse(xhr.responseText);
          var val = Math.round(json.fear_and_greed.score);
          cb(null, val);
        } catch(e) { cb("parse error"); }
      } else { cb("status " + xhr.status); }
    }
  };
  xhr.onerror = function() { cb("network error"); };
  xhr.send();
}

function fetchYahoo(tickers, cb) {
  var syms = tickers.join("%2C");
  var url = "https://corsproxy.io/?" + encodeURIComponent("https://query1.finance.yahoo.com/v7/finance/quote?symbols=" + syms + "&fields=regularMarketPrice,regularMarketChangePercent");
  var xhr = new XMLHttpRequest();
  xhr.open("GET", url, true);
  xhr.onreadystatechange = function() {
    if (xhr.readyState === 4) {
      if (xhr.status === 200) {
        try {
          var json = JSON.parse(xhr.responseText);
          var result = {};
          var quotes = json.quoteResponse.result;
          for (var i = 0; i < quotes.length; i++) {
            var q = quotes[i];
            result[q.symbol] = {
              price: q.regularMarketPrice,
              chg:   q.regularMarketChangePercent
            };
          }
          cb(null, result);
        } catch(e) { cb("parse error"); }
      } else { cb("status " + xhr.status); }
    }
  };
  xhr.onerror = function() { cb("network error"); };
  xhr.send();
}

function fetchCrypto(cb) {
  var ids = "bitcoin,ethereum,polkadot-2";
  var url = "https://api.coingecko.com/api/v3/simple/price?ids=" + ids + "&vs_currencies=usd&include_24hr_change=true";
  var xhr = new XMLHttpRequest();
  xhr.open("GET", url, true);
  xhr.onreadystatechange = function() {
    if (xhr.readyState === 4) {
      if (xhr.status === 200) {
        try {
          var json = JSON.parse(xhr.responseText);
          cb(null, json);
        } catch(e) { cb("parse error"); }
      } else { cb("status " + xhr.status); }
    }
  };
  xhr.onerror = function() { cb("network error"); };
  xhr.send();
}

/* ---- Render helpers ---- */

function priceTile(sym, price, chg) {
  var dispSym = sym.replace(".SI","");
  var chgColor = chg >= 0 ? "#22c55e" : "#ef4444";
  var chgStr = (chg >= 0 ? "+" : "") + chg.toFixed(2) + "%";
  var priceStr = price < 10 ? "$" + price.toFixed(4) : "$" + price.toFixed(2);
  return "<div class='price-tile'>" +
    "<div class='price-ticker'>" + dispSym + "</div>" +
    "<div class='price-val'>" + priceStr + "</div>" +
    "<div class='price-chg' style='color:" + chgColor + "'>" + chgStr + "</div>" +
    "</div>";
}

function newsCard(ticker, tickerColor, impact, headline, detail) {
  return "<div class='news-card' style='border-left-color:" + iColor[impact] + "'>" +
    "<div class='news-top'>" +
    "<span class='news-ticker' style='color:" + tickerColor + "'>" + ticker + "</span>" +
    "<span style='font-size:11px;font-weight:700;color:" + iColor[impact] + "'>" + iIcon[impact] + " " + impact + "</span>" +
    "</div>" +
    "<div class='news-headline'>" + headline + "</div>" +
    "<div class='news-detail'>" + detail + "</div>" +
    "</div>";
}

function renderPrices() {
  var uh = "";
  for (var i = 0; i < US_TICKERS.length; i++) {
    var sym = US_TICKERS[i];
    var d = liveData.prices[sym];
    if (d) { uh += priceTile(sym, d.price, d.chg); } else { uh += "<div class='price-tile'><div class='price-ticker'>" + sym + "</div><div style='font-size:11px;color:#64748b'>--</div></div>"; }
  }
  ge("us-prices").innerHTML = uh;

  var sh = "";
  for (var i = 0; i < SG_TICKERS.length; i++) {
    var sym = SG_TICKERS[i];
    var d = liveData.prices[sym];
    if (d) { sh += priceTile(sym, d.price, d.chg); } else { sh += "<div class='price-tile'><div class='price-ticker'>" + sym.replace(".SI","") + "</div><div style='font-size:11px;color:#64748b'>--</div></div>"; }
  }
  ge("sg-prices").innerHTML = sh;

  var map = { BTC:"bitcoin", ETH:"ethereum", DOT:"polkadot-2" };
  var ch = "";
  var coins = ["BTC","ETH","DOT"];
  for (var i = 0; i < coins.length; i++) {
    var sym = coins[i];
    var id = map[sym];
    var d = liveData.crypto[id];
    if (d) { ch += priceTile(sym, d.usd, d.usd_24h_change); } else { ch += "<div class='price-tile'><div class='price-ticker'>" + sym + "</div><div style='font-size:11px;color:#64748b'>--</div></div>"; }
  }
  ge("crypto-prices").innerHTML = ch;
}

function renderNews() {
  var nd = NEWS_DATA;

  ge("sent-overall").textContent = nd.sentiment.overall;
  ge("sent-summary").textContent = nd.sentiment.summary;
  var fh = "";
  for (var i = 0; i < nd.sentiment.funds.length; i++) {
    var f = nd.sentiment.funds[i];
    fh += "<div class='fund-row'><span class='fund-name'>" + f.name + "</span><span class='fund-view'>" + f.view + "</span><span class='fund-note'>-- " + f.note + "</span></div>";
  }
  ge("sent-funds").innerHTML = fh;

  var cats = [
    { label:"US Tech",   items:nd.usNews },
    { label:"SG Stocks", items:nd.sgNews },
    { label:"Crypto",    items:nd.cryptoNews }
  ];
  var mg = "";
  for (var c = 0; c < cats.length; c++) {
    var cat = cats[c];
    mg += "<div class='mini-card'><div class='mini-title'>" + cat.label + "</div>";
    var limit = cat.items.length < 4 ? cat.items.length : 4;
    for (var j = 0; j < limit; j++) {
      var it = cat.items[j];
      mg += "<div class='mini-row'><span style='color:" + iColor[it.impact] + ";font-weight:700'>" + iIcon[it.impact] + "</span><span><strong>" + it.ticker + "</strong> " + it.headline + "</span></div>";
    }
    mg += "</div>";
  }
  ge("mini-grid").innerHTML = mg;

  var uh = "";
  for (var i = 0; i < nd.usNews.length; i++) {
    var n = nd.usNews[i];
    uh += newsCard(n.ticker, "#38bdf8", n.impact, n.headline, n.detail);
  }
  ge("us-news").innerHTML = uh;

  var sh = "";
  for (var i = 0; i < nd.sgNews.length; i++) {
    var n = nd.sgNews[i];
    sh += "<div class='news-card' style='border-left-color:" + iColor[n.impact] + "'>" +
      "<div class='news-top'><span class='news-ticker' style='color:#a78bfa'>" + n.ticker + " <span style='font-size:11px;color:#64748b;font-weight:400'>" + n.name + "</span></span>" +
      "<span style='font-size:11px;font-weight:700;color:" + iColor[n.impact] + "'>" + iIcon[n.impact] + " " + n.impact + "</span></div>" +
      "<div class='news-headline'>" + n.headline + "</div><div class='news-detail'>" + n.detail + "</div></div>";
  }
  ge("sg-news").innerHTML = sh;

  var ch = "";
  for (var i = 0; i < nd.cryptoNews.length; i++) {
    var n = nd.cryptoNews[i];
    ch += newsCard(n.ticker, "#f59e0b", n.impact, n.headline, n.detail);
  }
  ge("crypto-news").innerHTML = ch;

  var wh = "";
  for (var i = 0; i < nd.watchlist.length; i++) {
    var w = nd.watchlist[i];
    var ac = aColor[w.action] || "#64748b";
    wh += "<div class='watch-card'><div class='watch-badge' style='background:" + ac + "33;border:2px solid " + ac + "'>" +
      "<span style='font-size:11px;font-weight:800;color:" + ac + "'>" + w.ticker + "</span>" +
      "<span style='font-size:9px;font-weight:700;text-transform:uppercase;color:" + ac + "'>" + w.action + "</span></div>" +
      "<div class='watch-note'>" + w.note + "</div></div>";
  }
  ge("watch-list").innerHTML = wh;
}

function renderFG() {
  var v = liveData.fg;
  if (!v) { return; }
  ge("fg-value").textContent = v;
  ge("fg-value").style.color = fgColor(v);
  ge("fg-label").textContent = fgLabel(v);
  ge("fg-label").style.color = fgColor(v);
  ge("fg-desc").textContent = "Live CNN Fear and Greed Index as of today.";
  ge("gauge-dot").style.left = Math.min(Math.max(v, 3), 97) + "%";
  ge("gauge-dot").style.background = fgColor(v);
}

/* ---- Main refresh ---- */

function refreshAll() {
  var btn = ge("refresh-btn");
  btn.disabled = true;
  btn.textContent = "Refreshing...";
  setStatus("Fetching Fear and Greed index...");

  renderNews();

  fetchFearGreed(function(err, val) {
    if (!err) {
      liveData.fg = val;
      renderFG();
      setStatus("Fear and Greed loaded. Fetching stock prices...");
    } else {
      setStatus("Fear and Greed failed (" + err + "). Fetching stock prices...");
    }

    var allTickers = US_TICKERS.concat(SG_TICKERS);
    fetchYahoo(allTickers, function(err2, prices) {
      if (!err2) {
        liveData.prices = prices;
        renderPrices();
        setStatus("Stock prices loaded. Fetching crypto...");
      } else {
        setStatus("Stock prices failed (" + err2 + "). Fetching crypto...");
      }

      fetchCrypto(function(err3, cdata) {
        if (!err3) {
          liveData.crypto = cdata;
          renderPrices();
          setStatus("All live data loaded. Last updated: " + new Date().toLocaleTimeString("en-SG"));
        } else {
          setStatus("Crypto fetch failed (" + err3 + "). Other data shown where available.");
        }
        btn.disabled = false;
        btn.textContent = "Refresh Live Data";
      });
    });
  });
}

/* ---- Init ---- */
ge("date-label").textContent = new Date().toLocaleDateString("en-SG", { weekday:"long", year:"numeric", month:"long", day:"numeric" });
refreshAll();

</script>
</body>
