//
Refresh button auto-fetches prices, Fear & Greed, and crypto prices
News + sentiment you update manually in a clearly marked NEWS_DATA block once a day, separate from the auto-fetched stuffcurrently does not fetch new data
//

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Morning Market Brief</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:sans-serif;background:#0f172a;color:#e2e8f0;min-height:100vh}
header{background:#1e293b;border-bottom:1px solid #334155;padding:14px 20px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px}
h1{font-size:17px;font-weight:700}
.sub{font-size:11px;color:#64748b;margin-top:2px}
#refresh-btn{background:#3b82f6;color:#fff;border:none;border-radius:8px;padding:8px 16px;font-weight:600;font-size:13px;cursor:pointer}
#refresh-btn:disabled{background:#334155;cursor:not-allowed}
#status-bar{width:100%;font-size:11px;color:#64748b;padding:6px 20px;background:#0f172a;border-bottom:1px solid #1e293b;min-height:24px}
nav{display:flex;border-bottom:1px solid #1e293b;overflow-x:auto}
nav button{background:none;border:none;border-bottom:2px solid transparent;padding:10px 16px;color:#64748b;font-size:13px;font-weight:600;cursor:pointer;white-space:nowrap}
nav button.active{color:#38bdf8;border-bottom-color:#38bdf8}
main{padding:16px;max-width:900px;margin:0 auto}
.tab-panel{display:none}
.tab-panel.active{display:block}
.overview-top{display:grid;grid-template-columns:180px 1fr;gap:14px;margin-bottom:14px}
.card{background:#1e293b;border-radius:12px;padding:16px}
#fg-card{text-align:center}
#fg-value{font-size:48px;font-weight:800}
#fg-label{font-size:14px;font-weight:700;margin:4px 0 8px}
#fg-desc{font-size:11px;color:#94a3b8;line-height:1.5;margin-top:8px}
.gauge-bar{height:6px;border-radius:3px;background:linear-gradient(to right,#ef4444,#f97316,#eab308,#84cc16,#22c55e);position:relative;margin:12px 0 4px}
.gauge-dot{position:absolute;top:-4px;width:14px;height:14px;border-radius:50%;border:2px solid #0f172a;transform:translateX(-50%)}
.gauge-labels{display:flex;justify-content:space-between;font-size:10px;color:#475569}
#sent-overall{font-size:14px;font-weight:700;color:#38bdf8;margin-bottom:6px}
#sent-summary{font-size:12px;color:#cbd5e1;line-height:1.6;margin-bottom:10px}
.fund-row{background:#0f172a;border-radius:6px;padding:7px 10px;display:flex;gap:10px;margin-bottom:6px;font-size:11px;flex-wrap:wrap}
.fund-name{font-weight:700;color:#f59e0b;min-width:90px}
.fund-view{font-weight:600;color:#e2e8f0;margin-right:4px}
.fund-note{color:#64748b}
.mini-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px}
.mini-card{background:#1e293b;border-radius:10px;padding:12px}
.mini-title{font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px}
.mini-row{display:flex;gap:6px;margin-bottom:5px;font-size:11px;color:#94a3b8}
.mini-row strong{color:#e2e8f0}
.price-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:10px;margin-bottom:16px}
.price-tile{background:#1e293b;border-radius:10px;padding:12px;text-align:center}
.price-ticker{font-size:12px;font-weight:800;color:#94a3b8;margin-bottom:4px}
.price-val{font-size:18px;font-weight:800;color:#f1f5f9}
.price-chg{font-size:12px;font-weight:700;margin-top:2px}
.news-card{background:#1e293b;border-radius:10px;padding:14px;border-left:3px solid #334155;margin-bottom:10px}
.news-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}
.news-ticker{font-weight:800;font-size:15px}
.news-headline{font-weight:600;font-size:13px;color:#f1f5f9;margin-bottom:4px}
.news-detail{font-size:12px;color:#94a3b8;line-height:1.6}
.watch-card{background:#1e293b;border-radius:10px;padding:14px;display:flex;gap:14px;align-items:center;margin-bottom:10px}
.watch-badge{min-width:56px;height:50px;border-radius:10px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}
.watch-note{font-size:13px;color:#94a3b8;line-height:1.6}
.hint{font-size:12px;color:#475569;margin-bottom:12px}
.section-label{font-size:12px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:1px;margin:16px 0 8px}
</style>
</head>
<body>

<header>
  <div>
    <h1>Morning Market Brief</h1>
    <p class="sub" id="date-label"></p>
  </div>
  <button id="refresh-btn" onclick="refreshAll()">Refresh Live Data</button>
</header>
<div id="status-bar">Ready.</div>

<nav>
  <button class="active" onclick="switchTab('overview',this)">Overview</button>
  <button onclick="switchTab('us',this)">US Tech</button>
  <button onclick="switchTab('sg',this)">SG Stocks</button>
  <button onclick="switchTab('crypto',this)">Crypto</button>
  <button onclick="switchTab('watchlist',this)">Watchlist</button>
</nav>

<main>
  <div id="tab-overview" class="tab-panel active">
    <div class="overview-top">
      <div class="card" id="fg-card">
        <div style="font-size:11px;color:#64748b;font-weight:600;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px">Fear and Greed</div>
        <div id="fg-value">--</div>
        <div id="fg-label">--</div>
        <div class="gauge-bar"><div class="gauge-dot" id="gauge-dot" style="left:50%"></div></div>
        <div class="gauge-labels"><span>Fear</span><span>Neutral</span><span>Greed</span></div>
        <div id="fg-desc"></div>
      </div>
      <div class="card">
        <div style="font-size:11px;color:#64748b;font-weight:600;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px">Market Sentiment</div>
        <div id="sent-overall"></div>
        <div id="sent-summary"></div>
        <div id="sent-funds"></div>
      </div>
    </div>
    <div class="mini-grid" id="mini-grid"></div>
  </div>

  <div id="tab-us" class="tab-panel">
    <p class="hint">W Portfolio: ASTS, AMZN, CRWD, GOOG, MSFT, PLTR, ZS, NOW, QQQ</p>
    <div class="section-label">Live Prices</div>
    <div class="price-grid" id="us-prices"></div>
    <div class="section-label">News (Manual)</div>
    <div id="us-news"></div>
  </div>

  <div id="tab-sg" class="tab-panel">
    <p class="hint">W: CapLand China TR, CapLand IntlCom, OCBC, DBS | G: YZJ Fin, Digital Core REIT</p>
    <div class="section-label">Live Prices</div>
    <div class="price-grid" id="sg-prices"></div>
    <div class="section-label">News (Manual)</div>
    <div id="sg-news"></div>
  </div>

  <div id="tab-crypto" class="tab-panel">
    <p class="hint">W Portfolio: BTC (0.2), ETH (8), DOT (1000)</p>
    <div class="section-label">Live Prices</div>
    <div class="price-grid" id="crypto-prices"></div>
    <div class="section-label">News (Manual)</div>
    <div id="crypto-news"></div>
  </div>

  <div id="tab-watchlist" class="tab-panel">
    <p class="hint">Action items based on current market conditions</p>
    <div id="watch-list"></div>
  </div>
</main>

<script>

/* =============================================================
